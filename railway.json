{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "gunicorn crwn.wsgi:application --bind 0.0.0.0:$PORT --workers 1 --threads 1 --timeout 30 --log-level debug --access-logfile - --error-logfile -",
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 10,
    "restartPolicyType": "ON_FAILURE"
  }
}